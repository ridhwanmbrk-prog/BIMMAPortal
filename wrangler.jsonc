{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bimmaportal",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bimma-absensi-db",
      "database_id": "dd5dbf9a-56c0-4ee0-85df-a698c7c99e56"
    }
  ],
  "vars": {
    "DOMAIN": "https://absensi.bimma-uab.my.id",
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  }
}
